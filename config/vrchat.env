# Launch-option defaults for VRChat. Run dist/gaze/openxr-gaze-bridge on the
# host alongside the game (default gaze file: /dev/shm/vrchat_dfr_gaze).
# Put these in Steam's VRChat launch options as:
#   env DXVK_GAZE_VRS=1 ... %command%
# For settings you can change while the game runs, use a config file instead:
# see config/dfr.conf.example and `dfrctl launch-options`.

DXVK_GAZE_VRS=1

# VRChat's HDR scene pass: Vulkan format 97 (RGBA16F).
# This avoids applying VRS to later/final passes and depth-only passes.
DXVK_GAZE_FMT=97

# The scene pass is rendered vertically flipped.
DXVK_GAZE_FLIP_Y=1

# Foveation shape: percent of one eye's image at full rate / at 2x2 or better.
DXVK_GAZE_FULL_AREA=45
DXVK_GAZE_MID_AREA=65
DXVK_GAZE_COARSE=auto

# Optional: live tuning and `dfrctl status`.
# DXVK_GAZE_CONFIG=/home/you/.config/vrchat-dfr/dfr.conf

# Optional diagnostics:
# DXVK_GAZE_DEBUG=1
# DXVK_GAZE_DOT=1
# DXVK_GAZE_DOT_RADIUS=24
