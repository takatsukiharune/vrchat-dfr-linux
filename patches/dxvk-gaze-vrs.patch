new file mode 100644
index 00000000..9f4ebdcf
--- /dev/null
+++ b/src/dxvk/dxvk_gaze_vrs.h
@@ -0,0 +1,101 @@
+#pragma once
+
+#include "dxvk_gaze_buffer.h"
+#include "dxvk_gaze_config.h"
+#include "dxvk_gaze_map.h"
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <map>
+#include <vector>
+
+#include "dxvk_include.h"
+
+namespace dxvk
+{
+
+  class DxvkDevice;
+  class DxvkCommandList;
+
+  bool dxvkGazeVrsEnabled(const DxvkDevice *device);
+
+  class DxvkGazeVrs
+  {
+
+  public:
+    explicit DxvkGazeVrs(DxvkDevice *device);
+    ~DxvkGazeVrs();
+
+    bool prepare(
+        DxvkCommandList *cmd,
+        VkExtent2D extent,
+        uint32_t layers,
+        VkFormat colorFormat,
+        VkSampleCountFlagBits samples,
+        VkRenderingFragmentShadingRateAttachmentInfoKHR &info);
+
+  private:
+    static constexpr uint32_t MaxLayers = 2u;
+
+    DxvkDevice *m_device = nullptr;
+
+    // Each slot owns both the attachment and its upload buffer. Completion is
+    // polled; an in-flight slot is never overwritten or waited on.
+    struct Slot : public RcObject
+    {
+      explicit Slot(DxvkDevice *device) : device(device) { }
+      ~Slot();
+      DxvkDevice *device;
+      VkImage image = VK_NULL_HANDLE;
+      VkImageView view = VK_NULL_HANDLE;
+      VkDeviceMemory imageMem = VK_NULL_HANDLE;
+      VkBuffer buffer = VK_NULL_HANDLE;
+      VkDeviceMemory bufferMem = VK_NULL_HANDLE;
+      Rc<sync::Fence> completion = new sync::Fence();
+      bool layoutInit = false;
+      // Request that produced the map this slot holds; filled once uploaded.
+      bool filled = false;
+      GazeMapRequest request;
+    };
+    std::array<Rc<Slot>, 2> m_slots;
+    GazeVrsBufferState m_buffers;
+    bool m_ok = false;
+    struct Worker;
+    std::unique_ptr<Worker> m_mapWorker;
+    std::unique_ptr<GazeMap> m_cpuMap;
+    bool m_loggedWorkerFailure = false;
+
+    VkExtent2D m_texel = {16u, 16u};
+    VkExtent2D m_maxTiles = {512u, 512u};
+
+    // Layers of the attachment: 1 when the driver has no layered
+    // shading-rate attachments, in which case only SBS passes are handled.
+    uint32_t m_layers = MaxLayers;
+    bool m_loggedLayered = false;
+
+    // Render-thread copy of the live configuration, refreshed without
+    // blocking whenever the worker publishes a new generation.
+    GazeConfig m_cfg;
+    uint32_t m_cfgGeneration = 0u;
+    void refreshConfig();
+
+    // Shading rates the device supports, per sample count.
+    struct RateSet
+    {
+      VkSampleCountFlagBits samples = VkSampleCountFlagBits(0);
+      uint32_t mask = 0u; // bit per rate code
+      std::vector<uint32_t> codes; // largest first
+    };
+    std::vector<RateSet> m_rates;
+    std::vector<uint32_t> m_loggedCoarse; // one log line per distinct outcome
+    const RateSet &queryRates(VkSampleCountFlagBits samples);
+    uint32_t resolveCoarse(VkSampleCountFlagBits samples);
+
+    std::map<std::array<uint32_t, 5>, uint32_t> m_shapes; // (w, h, layers, fmt, samples) -> pass count
+    std::chrono::steady_clock::time_point m_nextSummary = {};
+
+    bool createResources();
+  };
+
+}
