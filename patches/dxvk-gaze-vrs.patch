diff --git a/src/dxvk/dxvk_gaze_map.h b/src/dxvk/dxvk_gaze_map.h
new file mode 100644
index 00000000..92d164de
--- /dev/null
+++ b/src/dxvk/dxvk_gaze_map.h
@@ -0,0 +1,192 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace dxvk
+{
+  struct GazeMapRequest
+  {
+    // Width, height, layers, format, sample count.
+    std::array<uint32_t, 5> shape = {};
+    std::array<uint32_t, 2> texel = {16u, 16u};
+    std::array<float, 2> fx = {}, fy = {};
+    std::array<int32_t, 4> center = {}, dotCenter = {};
+    uint32_t flags = 0u, coarse = 5u;
+    float r1 = 0.20f, r2 = 0.40f;
+    float fullArea = -1.0f, midArea = -1.0f;
+
+    bool sameMap(const GazeMapRequest &other) const
+    {
+      // Preserve the existing tile-granularity gaze update cache.
+      return shape == other.shape && texel == other.texel
+          && center == other.center && flags == other.flags && coarse == other.coarse
+          && r1 == other.r1 && r2 == other.r2
+          && fullArea == other.fullArea && midArea == other.midArea;
+    }
+  };
+
+  struct GazeMap
+  {
+    GazeMapRequest request;
+    bool valid = true;
+    std::vector<uint8_t> data;
+  };
+
+  inline void generateGazeMap(const GazeMapRequest &request, GazeMap &result)
+  {
+    result.request = request;
+    result.valid = true;
+    const uint32_t width = request.shape[0], height = request.shape[1];
+    const uint32_t layers = request.shape[2];
+    const bool sbs = layers == 1u;
+    const uint32_t tilesX = (width + request.texel[0] - 1u) / request.texel[0];
+    const uint32_t tilesY = (height + request.texel[1] - 1u) / request.texel[1];
+    const uint32_t layerStride = (tilesX * tilesY + 3u) & ~3u;
+    result.data.resize(size_t(layerStride) * layers);
+    const float eyeW = sbs ? float(width) * 0.5f : float(width);
+    const float minDim = std::min(eyeW, float(height));
+    auto radius = [&](float area, float fallback) {
+      if (area < 0.0f)
+        return fallback;
+      const float a = std::clamp(area, 0.0f, 100.0f) * 0.01f;
+      return a >= 1.0f ? 10.0f : std::sqrt(a * eyeW * float(height) / 3.14159265f) / minDim;
+    };
+    const float r1 = radius(request.fullArea, request.r1);
+    const float r2 = radius(request.midArea, request.r2);
+    const uint32_t mid = std::min(5u, request.coarse);
+    for (uint32_t l = 0u; l < layers; l++)
+    {
+      for (uint32_t ty = 0u; ty < tilesY; ty++)
+      {
+        for (uint32_t tx = 0u; tx < tilesX; tx++)
+        {
+          const float px = (float(tx) + 0.5f) * float(request.texel[0]);
+          const float py = (float(ty) + 0.5f) * float(request.texel[1]);
+          const uint32_t eye = sbs ? (px < eyeW ? 0u : 1u) : l;
+          const float lx = sbs ? px - float(eye) * eyeW : px;
+          const float d = std::hypot(lx - request.fx[eye] * eyeW,
+              py - request.fy[eye] * float(height)) / minDim;
+          result.data[size_t(l) * layerStride + size_t(ty) * tilesX + tx]
+              = d >= r1 ? uint8_t(d >= r2 ? request.coarse : mid) : 0u;
+        }
+      }
+      std::fill(result.data.begin() + size_t(l) * layerStride + tilesX * tilesY,
+          result.data.begin() + size_t(l + 1u) * layerStride, 0u);
+    }
+  }
+
+  struct GazeMapGenerator
+  {
+    bool operator()(const GazeMapRequest &request, GazeMap &result) const
+    {
+      generateGazeMap(request, result);
+      return true;
+    }
+  };
+
+  // Thread primitives are supplied by DXVK in production and by the native
+  // test harness in tests. Only this worker allocates/fills CPU tile maps.
+  template<typename Thread = std::thread, typename Mutex = std::mutex,
+           typename Condition = std::condition_variable, typename Generator = GazeMapGenerator>
+  class GazeMapWorker
+  {
+  public:
+    explicit GazeMapWorker(std::function<void()> init = {}, Generator generate = {},
+        std::chrono::milliseconds poll = std::chrono::milliseconds(0))
+    : m_poll(poll), m_generate(std::move(generate)), m_thread([this, init = std::move(init)] {
+        try {
+          if (init) init();
+          run();
+        } catch (...) {
+          m_failed.store(true, std::memory_order_release);
+        }
+      }) { }
+
+    ~GazeMapWorker()
+    {
+      {
+        std::lock_guard<Mutex> lock(m_mutex);
+        m_stopped = true;
+      }
+      m_condition.notify_one();
+      if (m_thread.joinable()) m_thread.join();
+    }
+
+    bool failed() const { return m_failed.load(std::memory_order_acquire); }
+
+    // Never wait on the render thread, even for the mailbox mutex. Requests
+    // replace the queued request; a running job is allowed to finish so that
+    // continuous gaze motion cannot starve publication of completed maps.
+    bool exchange(const GazeMapRequest &request, bool needed, std::unique_ptr<GazeMap> &result)
+    {
+      std::unique_lock<Mutex> lock(m_mutex, std::try_to_lock);
+      if (!lock.owns_lock()) return false;
+      const bool ready = m_ready;
+      if (ready)
+      {
+        result.swap(m_result);
+        m_ready = false;
+      }
+      if (needed && (!m_requested || !request.sameMap(m_request)))
+      {
+        m_request = request;
+        m_requested = true;
+        m_hasJob = true;
+        m_condition.notify_one();
+      }
+      return ready;
+    }
+
+  private:
+    Mutex m_mutex;
+    Condition m_condition;
+    GazeMapRequest m_request;
+    bool m_requested = false, m_hasJob = false, m_stopped = false, m_ready = false;
+    std::unique_ptr<GazeMap> m_result;
+    std::atomic<bool> m_failed = {false};
+    std::chrono::milliseconds m_poll;
+    Generator m_generate;
+    Thread m_thread;
+
+    void run()
+    {
+      std::unique_ptr<GazeMap> building;
+      for (;;)
+      {
+        GazeMapRequest request;
+        {
+          std::unique_lock<Mutex> lock(m_mutex);
+          auto wake = [this] { return m_stopped || m_hasJob; };
+          if (m_requested && m_poll.count())
+            m_condition.wait_for(lock, m_poll, wake);
+          else
+            m_condition.wait(lock, wake);
+          if (m_stopped) return;
+          request = m_request;
+          m_hasJob = false;
+          // Recycle the previous CPU map returned by the render thread.
+          if (!building && !m_ready) building.swap(m_result);
+        }
+        if (!building) building = std::make_unique<GazeMap>();
+        if (!m_generate(request, *building)) continue;
+        {
+          std::lock_guard<Mutex> lock(m_mutex);
+          // Keep the last completed result even when newer gaze is queued.
+          building.swap(m_result);
+          m_ready = true;
+        }
+      }
+    }
+  };
+}
diff --git a/src/dxvk/dxvk_gaze_shm.h b/src/dxvk/dxvk_gaze_shm.h
new file mode 100644
index 00000000..5154df19
--- /dev/null
+++ b/src/dxvk/dxvk_gaze_shm.h
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+namespace gaze_bridge {
+// ABI v1: 64 bytes, little endian, 32-bit lock-free atomic words.
+// 0 magic, 1 version, 2 size, 3 sequence, 4 valid,
+// 5..6 left/right U, 7..8 left/right V (top = 0), 9..15 reserved.
+struct alignas(4) SharedGaze { uint32_t words[16]; };
+static_assert(sizeof(SharedGaze) == 64);
+static_assert(__atomic_always_lock_free(sizeof(uint32_t), nullptr));
+constexpr uint32_t Magic = 0x325a4147; // "GAZ2"
+constexpr uint32_t Version = 1;
+struct Sample { bool valid = false; float u[2] = {0.5f, 0.5f}; float v[2] = {0.5f, 0.5f}; };
+inline uint32_t bits(float f) { uint32_t n; std::memcpy(&n, &f, 4); return n; }
+inline float value(uint32_t n) { float f; std::memcpy(&f, &n, 4); return f; }
+inline uint32_t load(const uint32_t* p) { return __atomic_load_n(p, __ATOMIC_SEQ_CST); }
+inline void store(uint32_t* p, uint32_t n) { __atomic_store_n(p, n, __ATOMIC_SEQ_CST); }
+// Single writer, enforced by an exclusive flock for the lifetime of its mapping.
+inline void publish(SharedGaze* memory, const Sample& sample) {
+  uint32_t seq = (load(&memory->words[3]) + 1u) | 1u;
+  store(&memory->words[3], seq);
+  store(&memory->words[0], Magic);
+  store(&memory->words[1], Version);
+  store(&memory->words[2], sizeof(SharedGaze));
+  store(&memory->words[4], sample.valid ? 1 : 0);
+  for (unsigned eye = 0; eye < 2; ++eye) {
+    store(&memory->words[5 + eye], bits(sample.u[eye]));
+    store(&memory->words[7 + eye], bits(sample.v[eye]));
+  }
+  for (unsigned i = 9; i < 16; ++i) store(&memory->words[i], 0);
+  store(&memory->words[3], seq + 1u);
+}
+// Returns a coherent packet, including invalid packets (heartbeat).
+inline bool snapshot(const SharedGaze* memory, Sample& sample, uint32_t& sequence) {
+  for (unsigned attempt = 0; attempt < 4; ++attempt) {
+    uint32_t first = load(&memory->words[3]);
+    if (first & 1u) continue;
+    uint32_t words[16];
+    for (unsigned i = 0; i < 16; ++i) words[i] = load(&memory->words[i]);
+    if (first != load(&memory->words[3])) continue;
+    if (words[0] != Magic || words[1] != Version || words[2] != sizeof(SharedGaze)) return false;
+    sequence = first;
+    sample.valid = words[4] == 1;
+    for (unsigned eye = 0; eye < 2; ++eye) {
+      sample.u[eye] = value(words[5 + eye]);
+      sample.v[eye] = value(words[7 + eye]);
+      if (!std::isfinite(sample.u[eye]) || !std::isfinite(sample.v[eye]) ||
+          sample.u[eye] < 0 || sample.u[eye] > 1 || sample.v[eye] < 0 || sample.v[eye] > 1)
+        sample.valid = false;
+    }
+    return true;
+  }
+  return false;
+}
+// Require a sequence change after mapping: an old valid file is never accepted
+// just because the reader has started. No cross-process clock comparison needed.
+class Freshness {
+public:
+  using Clock = std::chrono::steady_clock;
+  explicit Freshness(Clock::time_point now = Clock::now()) : changed(now) {}
+  bool observe(uint32_t seq, Clock::time_point now) {
+    if (!seen) { seen = true; sequence = seq; return false; }
+    if (seq != sequence) { sequence = seq; changed = now; live = true; }
+    return live && !expired(now);
+  }
+  bool expired(Clock::time_point now) const { return now - changed >= std::chrono::milliseconds(100); }
+private:
+  uint32_t sequence = 0;
+  bool seen = false, live = false;
+  Clock::time_point changed;
+};
+} // namespace gaze_bridge
diff --git a/src/dxvk/dxvk_gaze_source.cpp b/src/dxvk/dxvk_gaze_source.cpp
new file mode 100644
index 00000000..713a0b4f
--- /dev/null
+++ b/src/dxvk/dxvk_gaze_source.cpp
@@ -0,0 +1,281 @@
+#include "dxvk_gaze_source.h"
+#include "../util/log/log.h"
+#include "../util/util_env.h"
+#include "../util/util_string.h"
+#include <cstdlib>
+
+#ifdef _WIN32
+#include "../util/util_win32_compat.h"
+#endif
+
+namespace dxvk
+{
+  DxvkGazeSource::DxvkGazeSource(std::string path, const GazeConfig &config)
+  : m_config(config), m_path(std::move(path))
+  {
+  }
+
+  DxvkGazeSource::~DxvkGazeSource()
+  {
+    closeSource();
+  }
+
+  void DxvkGazeSource::openSource()
+  {
+#ifdef _WIN32
+    auto now = std::chrono::steady_clock::now();
+
+    if (now < m_nextOpen)
+      return;
+
+    m_nextOpen = now + std::chrono::seconds(2);
+
+    HANDLE file = CreateFileA(m_path.c_str(), GENERIC_READ,
+                              FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                              nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+
+    if (file == INVALID_HANDLE_VALUE)
+      return;
+
+    if (GetFileSize(file, nullptr) < sizeof(GazeShm))
+    {
+      CloseHandle(file);
+      return;
+    }
+
+    HANDLE map = CreateFileMappingA(file, nullptr, PAGE_READONLY, 0, 0, nullptr);
+
+    if (!map)
+    {
+      CloseHandle(file);
+      return;
+    }
+
+    void *view = MapViewOfFile(map, FILE_MAP_READ, 0, 0, sizeof(GazeShm));
+
+    if (!view)
+    {
+      CloseHandle(map);
+      CloseHandle(file);
+      return;
+    }
+
+    m_file = file;
+    m_map = map;
+    m_shm = static_cast<const GazeShm *>(view);
+    m_sourceFreshness = gaze_bridge::Freshness{};
+
+    // A file left behind by a stopped bridge is reopened every two seconds.
+    if (!m_loggedOpen)
+      Logger::info(str::format("GazeVRS: gaze source opened: ", m_path));
+    m_loggedOpen = true;
+#endif
+  }
+
+  void DxvkGazeSource::closeSource()
+  {
+#ifdef _WIN32
+    if (m_shm) UnmapViewOfFile(const_cast<GazeShm *>(m_shm));
+    if (m_map) CloseHandle(HANDLE(m_map));
+    if (m_file) CloseHandle(HANDLE(m_file));
+#endif
+    m_shm = nullptr;
+    m_map = nullptr;
+    m_file = nullptr;
+  }
+
+  bool DxvkGazeSource::readGaze(Gaze &g)
+  {
+    if (!m_shm)
+      openSource();
+    if (!m_shm)
+      return false;
+
+    const auto now = std::chrono::steady_clock::now();
+    gaze_bridge::Sample sample;
+    uint32_t sequence = 0;
+    if (gaze_bridge::snapshot(m_shm, sample, sequence)
+        && m_sourceFreshness.observe(sequence, now) && sample.valid)
+    {
+      for (uint32_t eye = 0; eye < 2; eye++)
+      {
+        g.cx[eye] = sample.u[eye];
+        g.cy[eye] = sample.v[eye];
+        g.flipX[eye] = 0;
+        g.flipY[eye] = 0;
+      }
+      return true;
+    }
+
+    // Includes a writer killed during an odd sequence, and replaced files.
+    // Never keep using the last valid packet after the heartbeat stops.
+    if (m_sourceFreshness.expired(now))
+      closeSource();
+    return false;
+  }
+
+  bool DxvkGazeSource::generate(const GazeMapRequest &pass, GazeMap &result)
+  {
+    const auto now = std::chrono::steady_clock::now();
+    const uint32_t width = pass.shape[0], height = pass.shape[1];
+    const uint32_t texelWidth = pass.texel[0], texelHeight = pass.texel[1];
+    const bool sbs = pass.shape[2] == 1u;
+    const uint32_t tilesX = (width + texelWidth - 1u) / texelWidth;
+    const uint32_t tilesY = (height + texelHeight - 1u) / texelHeight;
+    Gaze g = {};
+
+    const GazeConfig &cfg = m_config;
+    const State previous = m_state;
+
+    // Nothing to build for the start-up request or while switched off.
+    if (!width || !height || !cfg.enabled)
+      return false;
+
+    if (cfg.fake != GazeFake::None)
+    {
+      float t = std::chrono::duration<float>(now.time_since_epoch()).count();
+      float a = 0.35f * std::sin(t * 6.2831853f / 6.0f);
+      float b = 0.35f * std::cos(t * 6.2831853f / 6.0f);
+      float x = 0.5f, y = 0.5f;
+
+      if (cfg.fake == GazeFake::X)
+        x += a;
+      else if (cfg.fake == GazeFake::Y)
+        y += a;
+      else if (cfg.fake == GazeFake::Fixed)
+        y = cfg.fixedY; // fixed spot, no motion
+      else if (cfg.fake == GazeFake::Circle)
+      {
+        x += a;
+        y += b;
+      } // grid: fixed center
+
+      for (uint32_t e = 0; e < 2u; e++)
+      {
+        g.cx[e] = x;
+        g.cy[e] = y;
+      }
+      m_state = State::Fake;
+    }
+    else if (readGaze(g))
+    {
+      m_heldGaze = g;
+      m_heldTime = now;
+      m_haveHeld = true;
+      m_state = State::Live;
+    }
+    else if (m_haveHeld && now - m_heldTime < std::chrono::milliseconds(cfg.holdMs))
+    {
+      // Blink or short dropout: the eye has not gone anywhere useful yet.
+      g = m_heldGaze;
+      m_state = State::Held;
+    }
+    else if (cfg.fallback == GazeFallback::Center)
+    {
+      for (uint32_t e = 0; e < 2u; e++)
+        g.cx[e] = g.cy[e] = 0.5f;
+      m_haveHeld = false;
+      m_state = State::Fallback;
+    }
+    else
+    {
+      if (m_state != State::None)
+        Logger::info("GazeVRS: no valid gaze data, rendering at full rate");
+      m_haveHeld = false;
+      m_state = State::None;
+      if (!m_lastValid) return false;
+      m_lastValid = false;
+      result.valid = false;
+      result.request = pass;
+      return true;
+    }
+
+    if (previous == State::None && m_state != State::Fake)
+      Logger::info(m_state == State::Fallback
+          ? "GazeVRS: no gaze data, foveating around the eye centre"
+          : "GazeVRS: gaze tracking active");
+
+    for (uint32_t e = 0; e < 2u; e++)
+    {
+      m_winMin[e] = std::min(m_winMin[e], g.cy[e]);
+      m_winMax[e] = std::max(m_winMax[e], g.cy[e]);
+      m_winMinX[e] = std::min(m_winMinX[e], g.cx[e]);
+      m_winMaxX[e] = std::max(m_winMaxX[e], g.cx[e]);
+    }
+
+    if (cfg.gainY != 1.0f)
+    {
+      for (uint32_t e = 0; e < 2u; e++)
+        g.cy[e] = std::clamp(0.5f + (g.cy[e] - 0.5f) * cfg.gainY, 0.0f, 1.0f);
+    }
+
+    if (cfg.swapEyes)
+    {
+      std::swap(g.cx[0], g.cx[1]);
+      std::swap(g.cy[0], g.cy[1]);
+      std::swap(g.flipX[0], g.flipX[1]);
+      std::swap(g.flipY[0], g.flipY[1]);
+    }
+
+    // Fovea position per eye in framebuffer space (0..1, origin top-left of the eye image).
+    // WiVRn reports display space and tells us whether the source image is mirrored.
+    float fx[2], fy[2];
+    uint32_t flags = 0u;
+
+    for (uint32_t e = 0; e < 2u; e++)
+    {
+      bool flipX = cfg.forceFlipX[e] >= 0 ? cfg.forceFlipX[e] != 0 : g.flipX[e] != 0;
+      bool flipY = cfg.forceFlipY[e] >= 0 ? cfg.forceFlipY[e] != 0 : g.flipY[e] != 0;
+
+      if (cfg.flipY)
+        flipY = !flipY;
+
+      fx[e] = flipX ? 1.0f - g.cx[e] : g.cx[e];
+      fy[e] = flipY ? 1.0f - g.cy[e] : g.cy[e];
+
+      flags |= (flipX ? 1u : 0u) << (e * 2u) | (flipY ? 1u : 0u) << (e * 2u + 1u);
+    }
+
+    const float eyeW = sbs ? float(width) * 0.5f : float(width);
+
+    const std::array<int32_t, 4> center = {
+        int32_t(fx[0] * eyeW), int32_t(fy[0] * float(height)),
+        int32_t(fx[1] * eyeW), int32_t(fy[1] * float(height))};
+
+    // Quantize to tile granularity so we only re-upload when something visible changes
+    const std::array<int32_t, 4> centerTiles = {
+        center[0] / int32_t(texelWidth), center[1] / int32_t(texelHeight),
+        center[2] / int32_t(texelWidth), center[3] / int32_t(texelHeight)};
+
+    if (cfg.debug && now >= m_nextGazeLog)
+    {
+      m_nextGazeLog = now + std::chrono::seconds(1);
+      Logger::info(str::format("GazeVRS: ", sbs ? "sbs " : "array ", width, "x", height,
+                               " display L(", g.cx[0], ",", g.cy[0], ") R(", g.cx[1], ",", g.cy[1], ")",
+                               " source flipX=", g.flipX[0], g.flipX[1], " flipY=", g.flipY[0], g.flipY[1],
+                               " -> fb L(", fx[0], ",", fy[0], ") R(", fx[1], ",", fy[1], ")",
+                               " tiles ", tilesX, "x", tilesY));
+      Logger::info(str::format("GazeVRS: raw range last 1s: cx L[", m_winMinX[0], ",", m_winMaxX[0],
+                               "] R[", m_winMinX[1], ",", m_winMaxX[1], "]  cy L[", m_winMin[0], ",", m_winMax[0],
+                               "] R[", m_winMin[1], ",", m_winMax[1], "]  gainY=", cfg.gainY));
+
+      for (uint32_t e = 0; e < 2u; e++)
+      {
+        m_winMin[e] = m_winMinX[e] = 1.0f;
+        m_winMax[e] = m_winMaxX[e] = 0.0f;
+      }
+    }
+
+    GazeMapRequest request = pass;
+    request.fx = {fx[0], fx[1]};
+    request.fy = {fy[0], fy[1]};
+    request.center = centerTiles;
+    request.dotCenter = center;
+    request.flags = flags;
+    if (m_lastValid && request.sameMap(m_lastRequest)) return false;
+    generateGazeMap(request, result);
+    m_lastRequest = request;
+    m_lastValid = true;
+    return true;
+  }
+}
diff --git a/src/dxvk/dxvk_gaze_source.h b/src/dxvk/dxvk_gaze_source.h
new file mode 100644
index 00000000..9bccf78f
--- /dev/null
+++ b/src/dxvk/dxvk_gaze_source.h
@@ -0,0 +1,56 @@
+#pragma once
+
+#include "dxvk_gaze_config.h"
+#include "dxvk_gaze_map.h"
+#include "dxvk_gaze_shm.h"
+#include <chrono>
+#include <string>
+
+namespace dxvk
+{
+  // Owned by the map worker. Mapping, heartbeat checks, gaze transforms,
+  // fake gaze and map generation never touch the rendering thread.
+  class DxvkGazeSource
+  {
+  public:
+    // What the last generate() call based its gaze on.
+    enum class State : uint32_t { None, Live, Held, Fallback, Fake };
+
+    explicit DxvkGazeSource(std::string path, const GazeConfig &config = {});
+    ~DxvkGazeSource();
+    DxvkGazeSource(const DxvkGazeSource &) = delete;
+    DxvkGazeSource &operator=(const DxvkGazeSource &) = delete;
+    bool generate(const GazeMapRequest &pass, GazeMap &result);
+    // Worker thread only, like generate().
+    void setConfig(const GazeConfig &config) { m_config = config; }
+    State state() const { return m_state; }
+    bool sourceOpen() const { return m_shm != nullptr; }
+
+  private:
+    using GazeShm = gaze_bridge::SharedGaze;
+    struct Gaze
+    {
+      float cx[2] = {}, cy[2] = {};
+      int32_t flipX[2] = {}, flipY[2] = {};
+    };
+    void *m_file = nullptr, *m_map = nullptr;
+    const GazeShm *m_shm = nullptr;
+    std::chrono::steady_clock::time_point m_nextOpen = {};
+    gaze_bridge::Freshness m_sourceFreshness;
+    GazeConfig m_config;
+    std::string m_path;
+    State m_state = State::None;
+    bool m_loggedOpen = false, m_lastValid = false;
+    // Last live sample, reused for hold_ms across blinks and bridge restarts.
+    Gaze m_heldGaze;
+    bool m_haveHeld = false;
+    std::chrono::steady_clock::time_point m_heldTime = {};
+    GazeMapRequest m_lastRequest;
+    float m_winMin[2] = {1.0f, 1.0f}, m_winMax[2] = {0.0f, 0.0f};
+    float m_winMinX[2] = {1.0f, 1.0f}, m_winMaxX[2] = {0.0f, 0.0f};
+    std::chrono::steady_clock::time_point m_nextGazeLog = {};
+    void openSource();
+    void closeSource();
+    bool readGaze(Gaze &g);
+  };
+}
diff --git a/src/dxvk/dxvk_gaze_vrs.cpp b/src/dxvk/dxvk_gaze_vrs.cpp
new file mode 100644
index 00000000..b83e6558
--- /dev/null
+++ b/src/dxvk/dxvk_gaze_vrs.cpp
@@ -0,0 +1,712 @@
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+#include "dxvk_cmdlist.h"
+#include "dxvk_device.h"
+#include "dxvk_gaze_dot.h"
+#include "dxvk_gaze_vrs.h"
+#include "dxvk_gaze_source.h"
+
+#include "../util/log/log.h"
+#include "../util/util_env.h"
+#include "../util/util_string.h"
+
+namespace dxvk
+{
+
+  // DXVK_GAZE_FILE / DXVK_GAZE_CONFIG may be given as plain Linux paths.
+  static std::string gazePath(const char *name, const char *fallback)
+  {
+    std::string path = env::getEnvVar(name);
+    if (path.empty())
+      path = fallback;
+#ifdef _WIN32
+    if (!path.empty() && path[0] == '/')
+    {
+      std::replace(path.begin(), path.end(), '/', '\\');
+      path = "Z:" + path;
+    }
+#endif
+    return path;
+  }
+
+  // Keep worker implementation and source ownership out of the rendering
+  // header. Destruction joins the worker before closing its source mapping.
+  struct DxvkGazeVrs::Worker
+  {
+    // Published by the worker, copied by the render thread with a try-lock.
+    dxvk::mutex configMutex;
+    GazeConfig config;
+    std::atomic<uint32_t> generation = {0u};
+
+    // Written by the render thread, reported in the status file.
+    std::atomic<uint32_t> candidates = {0u}, attached = {0u}, uploads = {0u};
+    std::atomic<uint32_t> width = {0u}, height = {0u}, layers = {0u}, format = {0u},
+        samples = {0u}, coarse = {0u};
+    VkExtent2D texel = {};
+
+    // Worker thread only from here on.
+    GazeConfigFile file;
+    DxvkGazeSource source;
+    std::string statusPath;
+    uint32_t statusTick = 0u;
+    std::chrono::steady_clock::time_point nextPoll = {}, nextStatus = {};
+
+    struct Generator
+    {
+      Worker *worker;
+      bool operator()(const GazeMapRequest &pass, GazeMap &result) const
+      {
+        worker->tick();
+        return worker->source.generate(pass, result);
+      }
+    };
+    // Last member: its thread starts in the constructor and uses the rest.
+    GazeMapWorker<dxvk::thread, dxvk::mutex, dxvk::condition_variable, Generator> maps;
+
+    Worker(GazeConfigFile configFile, VkExtent2D texelSize)
+    : config(configFile.config()), texel(texelSize), file(std::move(configFile)),
+      source(gazePath("DXVK_GAZE_FILE", "Z:\\dev\\shm\\vrchat_dfr_gaze"), config),
+      statusPath(file.path().empty() ? std::string() : file.path() + ".status"),
+      maps([] { env::setThreadName("dxvk-gaze-map"); },
+        Generator{this}, std::chrono::milliseconds(4)) { }
+
+    void tick()
+    {
+      const auto now = std::chrono::steady_clock::now();
+      if (now >= nextPoll)
+      {
+        nextPoll = now + std::chrono::milliseconds(250);
+        std::vector<std::string> messages;
+        const bool changed = file.reload(messages);
+        for (const auto &m : messages)
+          Logger::warn(str::format("GazeVRS: ", m));
+        if (changed)
+        {
+          source.setConfig(file.config());
+          {
+            std::lock_guard<dxvk::mutex> lock(configMutex);
+            config = file.config();
+          }
+          generation.fetch_add(1u, std::memory_order_release);
+          Logger::info(str::format("GazeVRS: config reloaded: ", file.config().describe()));
+        }
+      }
+      if (!statusPath.empty() && now >= nextStatus)
+      {
+        nextStatus = now + std::chrono::seconds(1);
+        writeStatus();
+      }
+    }
+
+    // One small file a second so "is it actually foveating?" can be answered
+    // from the host without a Proton log.
+    void writeStatus()
+    {
+      static const char *const states[] = {"none", "live", "held", "fallback", "fake"};
+      const uint32_t code = coarse.load();
+      char text[512];
+      const int length = std::snprintf(text, sizeof(text),
+          "tick=%u\nenabled=%d\ngaze=%s\nsource=%s\ncandidate_passes_per_s=%u\n"
+          "foveated_passes_per_s=%u\nmap_uploads_per_s=%u\npass=%ux%u layers=%u fmt=%u samples=%u\n"
+          "coarse=%ux%u\ntexel=%ux%u\n",
+          ++statusTick, int(file.config().enabled), states[uint32_t(source.state())],
+          source.sourceOpen() ? "open" : "closed", candidates.exchange(0u), attached.exchange(0u),
+          uploads.exchange(0u), width.load(), height.load(), layers.load(), format.load(),
+          samples.load(), 1u << (code >> 2u), 1u << (code & 3u), texel.width, texel.height);
+      if (length <= 0)
+        return;
+      if (std::FILE *out = std::fopen(statusPath.c_str(), "wb"))
+      {
+        std::fwrite(text, 1u, std::min(size_t(length), sizeof(text) - 1u), out);
+        std::fclose(out);
+      }
+    }
+  };
+
+  static uint32_t getFragmentRateCode(VkExtent2D size)
+  {
+    uint32_t w = 0u;
+    uint32_t h = 0u;
+
+    while (size.width > 1u)
+    {
+      size.width >>= 1;
+      w++;
+    }
+
+    while (size.height > 1u)
+    {
+      size.height >>= 1;
+      h++;
+    }
+
+    return (w << 2) | h;
+  }
+
+  bool dxvkGazeVrsEnabled(const DxvkDevice *device)
+  {
+    static const bool requested = env::getEnvVar("DXVK_GAZE_VRS") == "1";
+
+    if (!requested)
+      return false;
+
+    // Tiling GPUs render through secondary command buffers, which this
+    // integration does not set the dynamic shading rate for.
+    const bool supported = device->features().khrFragmentShadingRate.attachmentFragmentShadingRate
+        && !device->perfHints().preferRenderPassOps;
+
+    static std::atomic<bool> logged = {false};
+    if (!supported && !logged.exchange(true))
+      Logger::warn("GazeVRS: DXVK_GAZE_VRS=1 ignored: no attachment shading rate support on this device");
+
+    return supported;
+  }
+
+  DxvkGazeVrs::DxvkGazeVrs(DxvkDevice *device)
+      : m_device(device)
+  {
+    std::vector<std::string> messages;
+    GazeConfigFile file(gazePath("DXVK_GAZE_CONFIG", ""),
+        gazeConfigFromEnv([](const char *name) { return env::getEnvVar(name); }, messages));
+    file.reload(messages);
+    for (const auto &m : messages)
+      Logger::warn(str::format("GazeVRS: ", m));
+    m_cfg = file.config();
+
+    m_ok = createResources();
+    if (m_ok)
+    {
+      m_mapWorker = std::make_unique<Worker>(std::move(file), m_texel);
+      // Start the worker's poll loop now, so the config file is watched even
+      // before (or without) a pass that qualifies for VRS.
+      m_mapWorker->maps.exchange(GazeMapRequest(), true, m_cpuMap);
+    }
+
+    Logger::info(str::format("GazeVRS: init ", m_ok ? "ok" : "FAILED",
+                             ", double-buffered, texel ", m_texel.width, "x", m_texel.height,
+                             ", max tiles ", m_maxTiles.width, "x", m_maxTiles.height,
+                             ", layers ", m_layers, ", async map worker"));
+    Logger::info(str::format("GazeVRS: config: ", m_cfg.describe()));
+  }
+
+  DxvkGazeVrs::~DxvkGazeVrs()
+  {
+    m_mapWorker.reset();
+  }
+
+  DxvkGazeVrs::Slot::~Slot()
+  {
+    auto vk = device->vkd();
+    if (view) vk->vkDestroyImageView(vk->device(), view, nullptr);
+    if (image) vk->vkDestroyImage(vk->device(), image, nullptr);
+    if (buffer) vk->vkDestroyBuffer(vk->device(), buffer, nullptr);
+    if (imageMem) vk->vkFreeMemory(vk->device(), imageMem, nullptr);
+    if (bufferMem) vk->vkFreeMemory(vk->device(), bufferMem, nullptr);
+  }
+
+  bool DxvkGazeVrs::createResources()
+  {
+    auto vk = m_device->vkd();
+    const auto &memProps = m_device->adapter()->memoryProperties();
+
+    const auto &fsrProps = m_device->properties().khrFragmentShadingRate;
+
+    if (!(m_device->getFormatFeatures(VK_FORMAT_R8_UINT).optimal
+        & VK_FORMAT_FEATURE_2_FRAGMENT_SHADING_RATE_ATTACHMENT_BIT_KHR))
+    {
+      Logger::warn("GazeVRS: R8_UINT cannot be used as a shading rate attachment");
+      return false;
+    }
+
+    m_layers = fsrProps.layeredShadingRateAttachments ? MaxLayers : 1u;
+
+    if (fsrProps.minFragmentShadingRateAttachmentTexelSize.width && fsrProps.minFragmentShadingRateAttachmentTexelSize.height)
+      m_texel = fsrProps.minFragmentShadingRateAttachmentTexelSize;
+
+    // Preserve the 8192-pixel coverage of 512 tiles at 16x16 texels on
+    // devices with smaller attachment texels, without reducing the old capacity.
+    const uint32_t maxImageSize = m_device->properties().core.properties.limits.maxImageDimension2D;
+    m_maxTiles.width = std::min(maxImageSize, std::max(512u, (8192u + m_texel.width - 1u) / m_texel.width));
+    m_maxTiles.height = std::min(maxImageSize, std::max(512u, (8192u + m_texel.height - 1u) / m_texel.height));
+
+    auto findType = [&](uint32_t bits, VkMemoryPropertyFlags flags) -> int32_t
+    {
+      for (uint32_t i = 0; i < memProps.memoryTypeCount; i++)
+      {
+        if ((bits & (1u << i)) && (memProps.memoryTypes[i].propertyFlags & flags) == flags)
+          return int32_t(i);
+      }
+      return -1;
+    };
+
+    for (auto &slot : m_slots)
+    {
+      slot = new Slot(m_device);
+      VkImageCreateInfo imageInfo = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+      imageInfo.imageType = VK_IMAGE_TYPE_2D;
+      imageInfo.format = VK_FORMAT_R8_UINT;
+      imageInfo.extent = {m_maxTiles.width, m_maxTiles.height, 1u};
+      imageInfo.mipLevels = 1u;
+      imageInfo.arrayLayers = m_layers;
+      imageInfo.samples = VK_SAMPLE_COUNT_1_BIT;
+      imageInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+      imageInfo.usage = VK_IMAGE_USAGE_FRAGMENT_SHADING_RATE_ATTACHMENT_BIT_KHR | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+      imageInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+      imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+
+      if (vk->vkCreateImage(vk->device(), &imageInfo, nullptr, &slot->image))
+        return false;
+
+      VkMemoryRequirements req = {};
+      vk->vkGetImageMemoryRequirements(vk->device(), slot->image, &req);
+
+      int32_t type = findType(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+      if (type < 0)
+        return false;
+
+      VkMemoryAllocateInfo allocInfo = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+      allocInfo.allocationSize = req.size;
+      allocInfo.memoryTypeIndex = uint32_t(type);
+
+      if (vk->vkAllocateMemory(vk->device(), &allocInfo, nullptr, &slot->imageMem) || vk->vkBindImageMemory(vk->device(), slot->image, slot->imageMem, 0))
+        return false;
+
+      VkImageViewCreateInfo viewInfo = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+      viewInfo.image = slot->image;
+      viewInfo.viewType = VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+      viewInfo.format = VK_FORMAT_R8_UINT;
+      viewInfo.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, 0u, m_layers};
+
+      if (vk->vkCreateImageView(vk->device(), &viewInfo, nullptr, &slot->view))
+        return false;
+
+      VkBufferCreateInfo bufferInfo = {VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+      // Each layer starts at a four-byte aligned offset in the upload buffer.
+      const VkDeviceSize layerStride = (VkDeviceSize(m_maxTiles.width) * m_maxTiles.height + 3u) & ~VkDeviceSize(3u);
+      bufferInfo.size = layerStride * m_layers;
+      bufferInfo.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+      bufferInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+
+      if (vk->vkCreateBuffer(vk->device(), &bufferInfo, nullptr, &slot->buffer))
+        return false;
+
+      vk->vkGetBufferMemoryRequirements(vk->device(), slot->buffer, &req);
+      type = findType(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+      if (type < 0)
+        return false;
+
+      allocInfo.allocationSize = req.size;
+      allocInfo.memoryTypeIndex = uint32_t(type);
+
+      if (vk->vkAllocateMemory(vk->device(), &allocInfo, nullptr, &slot->bufferMem) || vk->vkBindBufferMemory(vk->device(), slot->buffer, slot->bufferMem, 0))
+        return false;
+    }
+
+    return true;
+  }
+
+  void DxvkGazeVrs::refreshConfig()
+  {
+    if (!m_mapWorker)
+      return;
+    const uint32_t generation = m_mapWorker->generation.load(std::memory_order_acquire);
+    if (generation == m_cfgGeneration)
+      return;
+    // Never wait for the worker; pick the change up on a later pass instead.
+    std::unique_lock<dxvk::mutex> lock(m_mapWorker->configMutex, std::try_to_lock);
+    if (!lock.owns_lock())
+      return;
+    m_cfg = m_mapWorker->config;
+    m_cfgGeneration = generation;
+  }
+
+  const DxvkGazeVrs::RateSet &DxvkGazeVrs::queryRates(VkSampleCountFlagBits samples)
+  {
+    for (const auto &set : m_rates)
+    {
+      if (set.samples == samples)
+        return set;
+    }
+
+    RateSet set;
+    set.samples = samples;
+
+    auto vki = m_device->vki();
+    VkPhysicalDevice physicalDevice = m_device->adapter()->handle();
+    uint32_t count = 0u;
+    VkResult result = vki->vkGetPhysicalDeviceFragmentShadingRatesKHR(physicalDevice, &count, nullptr);
+    std::vector<VkPhysicalDeviceFragmentShadingRateKHR> rates(count);
+
+    for (auto &rate : rates)
+      rate.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FRAGMENT_SHADING_RATE_KHR;
+
+    if (result == VK_SUCCESS && count)
+      result = vki->vkGetPhysicalDeviceFragmentShadingRatesKHR(physicalDevice, &count, rates.data());
+
+    if (result == VK_SUCCESS || result == VK_INCOMPLETE)
+    {
+      // Reported largest first.
+      for (uint32_t i = 0u; i < count && i < rates.size(); i++)
+      {
+        const VkExtent2D size = rates[i].fragmentSize;
+        if (!(rates[i].sampleCounts & VkSampleCountFlags(samples)) || size.width > 4u || size.height > 4u)
+          continue;
+        const uint32_t code = getFragmentRateCode(size);
+        if (!(set.mask & (1u << code)))
+          set.codes.push_back(code);
+        set.mask |= 1u << code;
+      }
+    }
+    else
+    {
+      Logger::warn(str::format("GazeVRS: failed to query fragment shading rates, result=", int32_t(result)));
+    }
+
+    // 1x1 is always available; without it the list above was unusable.
+    if (!(set.mask & 1u))
+    {
+      set.codes.push_back(0u);
+      set.mask |= 1u;
+    }
+
+    m_rates.push_back(set);
+    return m_rates.back();
+  }
+
+  // Never hand the driver a rate it did not advertise for this sample count:
+  // pick the requested rate, or the largest supported one that is no coarser.
+  uint32_t DxvkGazeVrs::resolveCoarse(VkSampleCountFlagBits samples)
+  {
+    const RateSet &set = queryRates(samples);
+    uint32_t code = set.codes.front();
+
+    if (!m_cfg.autoCoarse)
+    {
+      code = 0u;
+      for (uint32_t candidate : set.codes)
+      {
+        if ((candidate >> 2u) <= (m_cfg.coarse >> 2u) && (candidate & 3u) <= (m_cfg.coarse & 3u))
+        {
+          code = candidate;
+          break;
+        }
+      }
+    }
+
+    const uint32_t key = code | (uint32_t(samples) << 8u) | (m_cfg.autoCoarse ? 1u << 16u : m_cfg.coarse << 17u);
+    if (m_loggedCoarse.size() < 64u
+        && std::find(m_loggedCoarse.begin(), m_loggedCoarse.end(), key) == m_loggedCoarse.end())
+    {
+      m_loggedCoarse.push_back(key);
+      Logger::info(str::format("GazeVRS: coarse rate ", 1u << (code >> 2u), "x", 1u << (code & 3u),
+          " (code ", code, ") for ", uint32_t(samples), " sample(s), requested ",
+          m_cfg.autoCoarse ? std::string("auto") : str::format("code ", m_cfg.coarse)));
+    }
+    return code;
+  }
+
+  bool DxvkGazeVrs::prepare(
+      DxvkCommandList *cmd,
+      VkExtent2D extent,
+      uint32_t layers,
+      VkFormat colorFormat,
+      VkSampleCountFlagBits samples,
+      VkRenderingFragmentShadingRateAttachmentInfoKHR &info)
+  {
+    // Supported eye image layouts:
+    //  - array: 2 layers, one eye per layer
+    //  - sbs:   1 layer, both eyes side by side (left half / right half)
+    bool candidate = false;
+    bool sbs = false;
+
+    refreshConfig();
+    const GazeConfig &cfg = m_cfg;
+
+    if (m_ok)
+    {
+      if (cfg.forceW)
+      {
+        candidate = extent.width == cfg.forceW && extent.height == cfg.forceH && layers <= MaxLayers;
+        sbs = candidate && layers == 1u && extent.width * 10u >= extent.height * 18u;
+      }
+      else if (layers == MaxLayers)
+      {
+        candidate = extent.width >= cfg.minSize && extent.height >= cfg.minSize;
+      }
+      else if (layers == 1u)
+      {
+        sbs = extent.width * 10u >= extent.height * 18u && extent.height >= cfg.minSize;
+        candidate = sbs;
+      }
+    }
+
+    // Depth-only passes have no color target: no dots, and VRS there would desync depth from the color pass
+    if (colorFormat == VK_FORMAT_UNDEFINED)
+      candidate = false;
+
+    // Optional pass filters, to pick the scene pass out of several same-sized passes
+    if (candidate && cfg.onlySamples && uint32_t(samples) != cfg.onlySamples)
+      candidate = false;
+
+    if (candidate && cfg.onlyFormat && uint32_t(colorFormat) != cfg.onlyFormat)
+      candidate = false;
+
+    auto now = std::chrono::steady_clock::now();
+
+    if (cfg.debug)
+    {
+      m_shapes[{extent.width, extent.height, layers, uint32_t(colorFormat), uint32_t(samples)}]++;
+
+      if (now >= m_nextSummary)
+      {
+        if (m_nextSummary.time_since_epoch().count() != 0)
+        {
+          Logger::info("GazeVRS: --- passes in last 5s: WxH layers fmt samples count ---");
+          for (const auto &e : m_shapes)
+          {
+            if (e.second < 10u)
+              continue;
+            Logger::info(str::format("GazeVRS:   ", e.first[0], "x", e.first[1],
+                                     " layers=", e.first[2], " fmt=", e.first[3],
+                                     " samples=", e.first[4], " count=", e.second));
+          }
+        }
+        m_shapes.clear();
+        m_nextSummary = now + std::chrono::seconds(5);
+      }
+    }
+
+    const uint32_t usedLayers = sbs ? 1u : MaxLayers;
+
+    if (candidate && usedLayers > m_layers)
+    {
+      if (!m_loggedLayered)
+        Logger::warn("GazeVRS: this driver has no layered shading rate attachments; only side-by-side eye passes are foveated");
+      m_loggedLayered = true;
+      candidate = false;
+    }
+
+    // Switched off at run time: pipelines keep their dynamic state, the
+    // pass simply gets no attachment and shades at full rate.
+    if (!candidate || !cfg.enabled)
+      return false;
+
+    m_mapWorker->candidates.fetch_add(1u, std::memory_order_relaxed);
+    const uint32_t coarse = resolveCoarse(samples);
+
+    const uint32_t tilesX = (extent.width + m_texel.width - 1u) / m_texel.width;
+    const uint32_t tilesY = (extent.height + m_texel.height - 1u) / m_texel.height;
+
+    if (tilesX > m_maxTiles.width || tilesY > m_maxTiles.height)
+      return false;
+
+    const float eyeW = sbs ? float(extent.width) * 0.5f : float(extent.width);
+    const std::array<uint32_t, 5> shape = {
+        extent.width, extent.height, usedLayers, uint32_t(colorFormat), uint32_t(samples)};
+
+    // Publish only a completed upload. This barrier precedes any new upload,
+    // so rendering with the front image never depends on the back upload.
+    const std::array<uint64_t, 2> completed = {
+        m_slots[0]->completion->value(), m_slots[1]->completion->value()};
+    if (m_buffers.promote(completed))
+    {
+      VkImageMemoryBarrier2 ready = {VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2};
+      ready.srcStageMask = VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT;
+      ready.srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT;
+      ready.dstStageMask = VK_PIPELINE_STAGE_2_FRAGMENT_SHADING_RATE_ATTACHMENT_BIT_KHR;
+      ready.dstAccessMask = VK_ACCESS_2_FRAGMENT_SHADING_RATE_ATTACHMENT_READ_BIT_KHR;
+      ready.oldLayout = ready.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+      ready.srcQueueFamilyIndex = ready.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      ready.image = m_slots[m_buffers.active]->image;
+      ready.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, 0u, m_layers};
+      VkDependencyInfo dep = {VK_STRUCTURE_TYPE_DEPENDENCY_INFO};
+      dep.imageMemoryBarrierCount = 1u;
+      dep.pImageMemoryBarriers = &ready;
+      cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &dep);
+    }
+
+    GazeMapRequest request;
+    request.shape = shape;
+    request.texel = {m_texel.width, m_texel.height};
+    request.coarse = coarse;
+    request.r1 = cfg.r1;
+    request.r2 = cfg.r2;
+    request.fullArea = cfg.fullArea;
+    request.midArea = cfg.midArea;
+
+    if (m_mapWorker->maps.failed())
+    {
+      if (!m_loggedWorkerFailure)
+      {
+        Logger::err("GazeVRS: map worker failed; disabling VRS");
+        m_loggedWorkerFailure = true;
+      }
+      return false;
+    }
+    m_mapWorker->maps.exchange(request, true, m_cpuMap);
+    const int32_t back = m_buffers.writable(completed);
+    // A completed map can lag behind gaze, but must match this render target.
+    // Do not upload a map already displayed or already pending on the GPU.
+    auto matches = [&](const Rc<Slot> &slot) {
+      return slot->filled && slot->request.sameMap(m_cpuMap->request);
+    };
+    const bool upload = back >= 0 && m_cpuMap && m_cpuMap->valid
+        && m_cpuMap->request.shape == shape && m_cpuMap->request.coarse == coarse
+        && (m_buffers.active < 0 || !matches(m_slots[m_buffers.active]));
+
+    VkImageSubresourceRange allLayers = {VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, 0u, m_layers};
+
+    if (upload)
+    {
+      auto &slot = m_slots[back];
+      const uint32_t layerStride = (tilesX * tilesY + 3u) & ~3u;
+      const auto &data = m_cpuMap->data;
+      const auto &mapRequest = m_cpuMap->request;
+
+      // Previous uses of this slot have completed on the GPU. No broad
+      // graphics-to-transfer dependency is needed for a free back slot.
+      VkImageMemoryBarrier2 imgBarrier = {VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2};
+      imgBarrier.srcStageMask = VK_PIPELINE_STAGE_2_NONE;
+      imgBarrier.dstStageMask = VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT;
+      imgBarrier.dstAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT;
+      imgBarrier.oldLayout = slot->layoutInit ? VK_IMAGE_LAYOUT_GENERAL : VK_IMAGE_LAYOUT_UNDEFINED;
+      imgBarrier.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+      imgBarrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      imgBarrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      imgBarrier.image = slot->image;
+      imgBarrier.subresourceRange = allLayers;
+
+      VkDependencyInfo dep = {VK_STRUCTURE_TYPE_DEPENDENCY_INFO};
+      dep.imageMemoryBarrierCount = 1u;
+      dep.pImageMemoryBarriers = &imgBarrier;
+      cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &dep);
+
+      for (size_t off = 0u; off < data.size(); off += 65536u)
+      {
+        size_t chunk = std::min<size_t>(65536u, data.size() - off);
+        cmd->cmdUpdateBuffer(DxvkCmdBuffer::ExecBuffer, slot->buffer, off, chunk, data.data() + off);
+      }
+
+      VkBufferMemoryBarrier2 bufBarrier2 = {VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER_2};
+      bufBarrier2.srcQueueFamilyIndex = bufBarrier2.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      bufBarrier2.buffer = slot->buffer;
+      bufBarrier2.size = VK_WHOLE_SIZE;
+      bufBarrier2.srcStageMask = VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT;
+      bufBarrier2.srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT;
+      bufBarrier2.dstStageMask = VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT;
+      bufBarrier2.dstAccessMask = VK_ACCESS_2_TRANSFER_READ_BIT;
+
+      VkDependencyInfo dep2 = {VK_STRUCTURE_TYPE_DEPENDENCY_INFO};
+      dep2.bufferMemoryBarrierCount = 1u;
+      dep2.pBufferMemoryBarriers = &bufBarrier2;
+      cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &dep2);
+
+      std::array<VkBufferImageCopy2, MaxLayers> regions = {};
+
+      for (uint32_t l = 0; l < usedLayers; l++)
+      {
+        regions[l].sType = VK_STRUCTURE_TYPE_BUFFER_IMAGE_COPY_2;
+        regions[l].bufferOffset = VkDeviceSize(l) * layerStride;
+        regions[l].bufferRowLength = 0u;
+        regions[l].bufferImageHeight = 0u;
+        regions[l].imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0u, l, 1u};
+        regions[l].imageOffset = {0, 0, 0};
+        regions[l].imageExtent = {tilesX, tilesY, 1u};
+      }
+
+      VkCopyBufferToImageInfo2 copyInfo = {VK_STRUCTURE_TYPE_COPY_BUFFER_TO_IMAGE_INFO_2};
+      copyInfo.srcBuffer = slot->buffer;
+      copyInfo.dstImage = slot->image;
+      copyInfo.dstImageLayout = VK_IMAGE_LAYOUT_GENERAL;
+      copyInfo.regionCount = usedLayers;
+      copyInfo.pRegions = regions.data();
+      cmd->cmdCopyBufferToImage(DxvkCmdBuffer::ExecBuffer, &copyInfo);
+
+      slot->layoutInit = true;
+      slot->filled = true;
+      slot->request = mapRequest;
+      m_mapWorker->uploads.fetch_add(1u, std::memory_order_relaxed);
+      cmd->track(slot);
+      cmd->queueSignal(slot->completion, m_buffers.upload(back));
+    }
+
+    // During startup or a render-target change, use full-rate rendering until
+    // a compatible attachment is ready rather than waiting for an upload.
+    if (!m_cpuMap || !m_cpuMap->valid || m_buffers.active < 0
+        || !m_slots[m_buffers.active]->filled
+        || m_slots[m_buffers.active]->request.shape != shape
+        || m_slots[m_buffers.active]->request.coarse != coarse)
+      return false;
+
+    auto &front = m_slots[m_buffers.active];
+    cmd->track(front);
+    cmd->queueSignal(front->completion, m_buffers.read());
+
+    m_mapWorker->attached.fetch_add(1u, std::memory_order_relaxed);
+    m_mapWorker->width.store(extent.width, std::memory_order_relaxed);
+    m_mapWorker->height.store(extent.height, std::memory_order_relaxed);
+    m_mapWorker->layers.store(layers, std::memory_order_relaxed);
+    m_mapWorker->format.store(uint32_t(colorFormat), std::memory_order_relaxed);
+    m_mapWorker->samples.store(uint32_t(samples), std::memory_order_relaxed);
+    m_mapWorker->coarse.store(coarse, std::memory_order_relaxed);
+
+    const bool grid = cfg.fake == GazeFake::Grid;
+    // Debug overlay (sbs only): colored squares drawn at the end of the pass.
+    //  - normal: magenta dots at the displayed attachment's saved gaze,
+    //    including its upload latency and tile-granularity update caching.
+    //  - FAKE=grid: 8 differently colored squares at known framebuffer positions
+    if ((cfg.dot || grid) && sbs)
+    {
+      g_gazeDot.passActive = true;
+      g_gazeDot.width = int32_t(extent.width);
+      g_gazeDot.height = int32_t(extent.height);
+      g_gazeDot.radius = cfg.dotRadius;
+      g_gazeDot.x[0] = front->request.dotCenter[0];
+      g_gazeDot.y[0] = front->request.dotCenter[1];
+      g_gazeDot.x[1] = int32_t(eyeW) + front->request.dotCenter[2];
+      g_gazeDot.y[1] = front->request.dotCenter[3];
+      g_gazeDot.count = 0;
+
+      auto add = [&](float px, float py, int32_t r, float cr, float cg, float cb)
+      {
+        if (g_gazeDot.count >= 16u)
+          return;
+        auto &d = g_gazeDot.dots[g_gazeDot.count++];
+        d.x = int32_t(px * float(extent.width));
+        d.y = int32_t(py * float(extent.height));
+        d.r = r;
+        d.rgb[0] = cr;
+        d.rgb[1] = cg;
+        d.rgb[2] = cb;
+      };
+
+      if (grid)
+      {
+        const int32_t sz = 70;
+        add(0.03f, 0.06f, sz, 1.0f, 0.0f, 0.0f); // top-left corner      red
+        add(0.97f, 0.06f, sz, 0.0f, 1.0f, 0.0f); // top-right corner     green
+        add(0.03f, 0.94f, sz, 0.0f, 0.0f, 1.0f); // bottom-left corner   blue
+        add(0.97f, 0.94f, sz, 1.0f, 1.0f, 0.0f); // bottom-right corner  yellow
+        add(0.25f, 0.50f, sz, 1.0f, 1.0f, 1.0f); // center of left half  white
+        add(0.75f, 0.50f, sz, 1.0f, 0.0f, 1.0f); // center of right half magenta
+        add(0.25f, 0.12f, sz, 0.0f, 1.0f, 1.0f); // top of left half     cyan
+        add(0.75f, 0.12f, sz, 1.0f, 0.5f, 0.0f); // top of right half    orange
+      }
+      else
+      {
+        add(float(g_gazeDot.x[0]) / float(extent.width), float(g_gazeDot.y[0]) / float(extent.height), cfg.dotRadius, 1.0f, 0.0f, 1.0f);
+        add(float(g_gazeDot.x[1]) / float(extent.width), float(g_gazeDot.y[1]) / float(extent.height), cfg.dotRadius, 1.0f, 0.0f, 1.0f);
+      }
+    }
+
+    info.imageView = front->view;
+    info.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+    info.shadingRateAttachmentTexelSize = m_texel;
+    return true;
+  }
+
+}
