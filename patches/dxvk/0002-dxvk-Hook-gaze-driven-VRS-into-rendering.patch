 src/dxvk/dxvk_context.cpp     | 122 +++++++++++++++++++++++++++++++++-
 src/dxvk/dxvk_context.h       |   6 ++
 src/dxvk/dxvk_device_info.cpp |   5 ++
 src/dxvk/dxvk_device_info.h   |   3 +
 src/dxvk/dxvk_framebuffer.h   |   1 +
 src/dxvk/dxvk_graphics.cpp    |  19 ++++++
 src/dxvk/dxvk_graphics.h      |   2 +-
 src/dxvk/dxvk_shader.cpp      |  15 +++++
 src/dxvk/meson.build          |   2 +
 src/vulkan/vulkan_loader.h    |   8 +++
 11 files changed, 188 insertions(+), 2 deletions(-)

